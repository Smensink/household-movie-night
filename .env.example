# Database
DATABASE_URL="postgresql://movienight:movienight@db:5432/movienight?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# OMDB API (get key at https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=""

# Trakt API (get at https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=""

# TMDB API (get at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=""

# Internal API key for Docker startup scripts (auto-generated if not set)
INTERNAL_API_KEY=""

